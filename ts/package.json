{
  "name": "@eco-foundation/delivery",
  "version": "0.1.0",
  "description": "TypeScript SDK for EcoDelivery \u2014 the outcome verifier at the end of a swap route (EVM + Solana)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eco/eco-delivery.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/eco/eco-delivery#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    },
    "./svm": {
      "types": "./dist/svm.d.ts",
      "import": "./dist/svm.js",
      "require": "./dist/svm.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:drift": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run check:drift && npm run typecheck && npm run build && npm test",
    "test": "node --test test/sdk.test.mjs"
  },
  "peerDependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.21.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ethereum",
    "solana",
    "swap",
    "settlement",
    "eco"
  ]
}
